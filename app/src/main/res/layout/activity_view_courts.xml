<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewCourtsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved Padel Courts"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/courtsCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved courts: 0"
        android:textSize="16sp"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/emptyCourtsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No courts saved."
        android:textSize="16sp"
        android:layout_marginTop="32dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/courtsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/backToMenuButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Menu"
        android:layout_marginTop="12dp"/>

</LinearLayout>
