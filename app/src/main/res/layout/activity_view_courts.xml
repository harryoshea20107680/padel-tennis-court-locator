<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewCourtsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Padel Courts"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/courtsCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved courts: 0"
            android:textSize="16sp"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/emptyCourtsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No courts saved."
            android:textSize="16sp"
            android:layout_marginTop="32dp"/>

        <LinearLayout
            android:id="@+id/courtsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/backToMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
